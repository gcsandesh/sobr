# sobr — environment variables
# Copy to .env (at this repo root) and fill in. NEVER commit the real .env (gitignored).
# The Expo app loads THIS root .env via apps/mobile/app.config.js, so a single root
# .env works for the whole workspace. After editing it, restart the dev server
# (web: re-run `pnpm web`; native: `pnpm app --clear`).
# This app stores sensitive personal health data — keep these private.

# --- Supabase (client-safe; exposed to the app bundle) ---
# Found in: Supabase dashboard > Project Settings > API
EXPO_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
EXPO_PUBLIC_SUPABASE_ANON_KEY="YOUR-ANON-PUBLIC-KEY"

# --- Drizzle / migrations (server-side only; NEVER ship in the app bundle) ---
# Supabase dashboard > Project Settings > Database > Connection string (URI, "Session" pooler is fine)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.YOUR-PROJECT.supabase.co:5432/postgres"

# --- Google / Apple sign-in (Phase 2; not wired up yet) ---
# The Google/Apple *client secrets* live in the Supabase dashboard (Auth > Providers),
# NEVER in the app. Two implementation paths — fill in only what your chosen path needs:
#
# Path A — Supabase OAuth redirect (recommended: works web + native, fewest secrets in-app).
#   Nothing here is required; the app uses the Supabase URL above + the "sobr://" scheme.
#   You configure providers + allowed redirect URLs in the Supabase dashboard.
#
# Path B — Native ID-token sign-in (nicer native sheets; needs a custom dev build).
#   Google: create OAuth client IDs in Google Cloud Console and paste them here.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID="xxxxx.apps.googleusercontent.com"
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID="xxxxx.apps.googleusercontent.com"
#   Apple: no in-app key needed — configured via your Apple Developer account + Supabase.

# --- Dev-only: skip sign-in/onboarding, jump straight to the tabs ---
# Handy in Expo Go, where Google sign-in can't run (needs a custom dev build) and
# email-OTP needs a real inbox. Only takes effect in dev (__DEV__) — structurally
# inert in any production build even if this leaks into one. Leave unset/0 normally.
# EXPO_PUBLIC_SKIP_AUTH=1

# --- Email (server-side only) ---
# Resend API key for reminder + weekly-progress emails. The live copy is stored
# in Supabase Vault under the name 'resend_api_key' (see packages/db/migrations/
# 0002_email.sql); this env var is only a staging spot before moving it there.
RESEND_API_KEY=
