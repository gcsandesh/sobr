{
  "expo": {
    "name": "sobr",
    "slug": "sobr",
    "version": "0.1.0",
    "scheme": "sobr",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "backgroundColor": "#F0F5F3",
    "icon": "./assets/brand/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sobr.app"
    },
    "android": {
      "package": "com.sobr.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/icon.png",
        "backgroundColor": "#1F6F6B"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/brand/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F0F5F3"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "sobr uses your photos so you can attach memories to a tracked day.",
          "cameraPermission": "sobr uses your camera so you can capture a moment for a tracked day."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    }
  }
}
