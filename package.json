{
  "name": "sobr",
  "version": "0.1.0",
  "private": true,
  "description": "sobr — a calm, growth-oriented drinking-habit tracker",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:core": "pnpm --filter @sobr/core test",
    "app": "pnpm --filter @sobr/mobile start",
    "web": "pnpm --filter @sobr/mobile web",
    "ios": "pnpm --filter @sobr/mobile ios",
    "android": "pnpm --filter @sobr/mobile android",
    "db:generate": "pnpm --filter @sobr/db generate",
    "db:migrate": "pnpm --filter @sobr/db migrate"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
